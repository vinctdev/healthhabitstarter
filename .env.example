# Copy to .env (next to docker-compose.yml). For local development use backend/.env instead
# and leave the database settings out: the backend then uses SQLite (backend/dev.db).

# PostgreSQL (Docker). Pick a long random password, e.g. `openssl rand -hex 32`.
DB_PASSWORD=change-me
# DB_USER=healthhabitstarter
# DB_NAME=healthhabitstarter
# External PostgreSQL instead of the bundled one: DB_URL=postgresql://user:password@host:5432/dbname

# Your IANA time zone (used to convert health-tracker timestamps), e.g. Europe/Berlin, America/New_York
TZ=Europe/Berlin

# Google Gemini (optional): AI mentor, photo analysis, nutrition suggestions, goal polishing.
# Free key: https://aistudio.google.com/apikey · Setup and privacy notes: docs/gemini.md
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Health tracker: auto | google | demo | none
# auto = google if GOOGLE_HEALTH_REFRESH_TOKEN is set, otherwise none (no tracker data).
# demo = generated data to try the app. Own tracker (Whoop, Garmin, Oura, ...): docs/adding-a-health-provider.md
HEALTH_PROVIDER=auto

# Google Health API (Fitbit / Pixel Watch), setup: docs/google-health.md
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REFRESH_TOKEN=

